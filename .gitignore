/target
/.claude

# Finder metadata; written anywhere a directory is opened on macOS.
.DS_Store

# Packaged distribution artifacts (scripts/package.sh output); regenerable.
/dist

# Local real-UI capture artifacts (brightfield-shot / parity PNGs); regenerable.
/render-proof

# egui_kittest failure output: the actual render (*.new.png) and the perceptual
# diff (*.diff.png) it writes next to a baseline when a snapshot test fails.
# Only the baseline itself is committed (per the egui_kittest README).
**/tests/snapshots/**/*.diff.png
**/tests/snapshots/**/*.new.png
**/tests/snapshots/**/*.old.png

# The shipped start thumbnails are baselines too — regenerated from the bundled
# specs by the same snapshot engine — so its failure artifacts land beside them.
/crates/brightfield-shell/assets/starts/*.diff.png
/crates/brightfield-shell/assets/starts/*.new.png
/crates/brightfield-shell/assets/starts/*.old.png

# User-supplied geo data for examples/live/ (download per each spec's header;
# never committed — see examples/live/us-states.yaml).
#
# That rule is about DOWNLOADED example data and it still stands. It is not a
# rule about third-party bytes in general: the front door's gallery datasets
# under crates/brightfield-shell/assets/starts/ ARE committed, deliberately, so
# a start opens with no network — each beside the Frictionless descriptor
# recording its upstream source, revision and licence, which is what makes the
# bytes traceable rather than anonymous. Nothing here downloads them.
/examples/live/*.json

# The benchmark harness generated datasets and substituted scenario specs —
# deterministic pure functions of the row index, regenerated on demand by
# `cargo run --release -p brightfield-bench`. Only results are committed.
/benchmarks/.data
