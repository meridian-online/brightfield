<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>brightfield</string>
	<!-- Resolves to Contents/Resources/Brightfield.icns; the extension is
	     implied, and Launch Services appends it. -->
	<key>CFBundleIconFile</key>
	<string>Brightfield</string>
	<key>CFBundleIdentifier</key>
	<string>online.meridian.brightfield</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Brightfield</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- scripts/package.sh overwrites the three placeholders below with
	     `plutil -replace` on the bundle's copy: the two version strings from
	     the crate version, and the system floor read out of the built
	     executable. This file keeps the placeholders so it lints on its own. -->
	<key>CFBundleShortVersionString</key>
	<string>0.0.0</string>
	<key>CFBundleVersion</key>
	<string>0.0.0</string>
	<key>LSMinimumSystemVersion</key>
	<string>0.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<!-- The documents Launch Services may hand Brightfield, by double-click,
	     Open With or a drop on the Dock icon. Each opens as a Protocol: data
	     makes a new one, and a Protocol directory, a plain folder holding
	     arcform.yaml, opens where it is. A Protocol directory is not declared
	     as a package, so Finder keeps it browsable as the folder it is, and it
	     reaches Brightfield as a public.folder. The common spreadsheet and
	     database types take the Alternate rank, so Brightfield is offered
	     under Open With without taking the double-click from the app that has
	     it; Parquet and DuckDB have no other owner on a Mac. A zip is not
	     declared: most zips are not Protocol archives. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Delimited text</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.comma-separated-values-text</string>
				<string>public.tab-separated-values-text</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Excel workbook</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>org.openxmlformats.spreadsheetml.sheet</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Parquet file</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Default</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>org.apache.parquet</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>DuckDB database</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Default</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>org.duckdb.database</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>SQLite database</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.database</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Folder of data or Protocol</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.folder</string>
			</array>
		</dict>
	</array>
	<!-- macOS ships no type for Parquet, DuckDB or SQLite files: it gives each
	     extension a dynamic type that nothing above can name. Importing them
	     names them, and an imported declaration gives way to one another app
	     exports. SQLite conforms to public.database, which is how the entry
	     above reaches it; DuckDB does too. The extensions are the ones the
	     window's open reads. -->
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>org.apache.parquet</string>
			<key>UTTypeDescription</key>
			<string>Apache Parquet file</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>parquet</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.apache.parquet</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>org.duckdb.database</string>
			<key>UTTypeDescription</key>
			<string>DuckDB database</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.database</string>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>duckdb</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>org.sqlite.sqlite3</string>
			<key>UTTypeDescription</key>
			<string>SQLite database</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.database</string>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>sqlite</string>
					<string>db</string>
				</array>
			</dict>
		</dict>
	</array>
	<!-- The brightfield:// link a web page's "Open in Brightfield" button
	     builds. It reaches the app as a get-URL Apple Event. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>online.meridian.brightfield</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>brightfield</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
