 fn main() {
     let out_dir = env::var("OUT_DIR").unwrap();
+    // Brightfield's change to this crate: `managed-linked` links the DuckDB
+    // library Brightfield's managed edition builds (scripts/build-duckdb.sh), even
+    // where another crate in the graph asks for `bundled`. See managed_linked.rs.
+    if cfg!(feature = "managed-linked") {
+        #[cfg(feature = "managed-linked")]
+        managed_linked::main(&out_dir);
+        return;
+    }
     #[cfg(feature = "bundled")]
     build_bundled_backend::main(&out_dir);
     #[cfg(not(feature = "bundled"))]
     build_linked::main(&out_dir)
 }
 
