{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "tpep_pickup_datetime": {"type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}[ T][0-9]{2}:[0-9]{2}:[0-9]{2}"},
    "trip_distance": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?([eE][+-]?[0-9]+)?$"},
    "PULocationID": {"type": "string", "pattern": "^([1-9]|[1-9][0-9]|1[0-9][0-9]|2[0-6][0-9])$"},
    "passenger_count": {"type": "string", "pattern": "^[0-9]$"},
    "total_amount": {"type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?([eE][+-]?[0-9]+)?$"}
  },
  "required": ["tpep_pickup_datetime", "trip_distance", "PULocationID", "total_amount"]
}
