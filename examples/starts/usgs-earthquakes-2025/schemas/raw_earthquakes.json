{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "time": {"type": "string", "pattern": "^2025-[0-9]{2}-[0-9]{2}[ T][0-9]{2}:[0-9]{2}:[0-9]{2}"},
    "latitude": {"type": "string", "pattern": "^-?([0-8]?\\d(\\.\\d+)?|90(\\.0+)?)$"},
    "longitude": {"type": "string", "pattern": "^-?((1[0-7]\\d|\\d?\\d)(\\.\\d+)?|180(\\.0+)?)$"},
    "depth": {"type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?$"},
    "mag": {"type": "string", "pattern": "^([4-9])(\\.[0-9]+)?$"},
    "magType": {"type": "string", "enum": ["mb", "mww", "mwr", "mwb", "mwc", "ml", "ms", "mw"]},
    "place": {"type": "string", "minLength": 1}
  },
  "required": ["time", "latitude", "longitude", "depth", "mag", "magType", "place"]
}
